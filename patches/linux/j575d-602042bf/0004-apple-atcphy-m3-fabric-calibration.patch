+	if (atcphy->fabric_enabled) {
+		res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "fabric");
+		addr = devm_ioremap_resource(&pdev->dev, res);
+		if (IS_ERR(addr))
+			return dev_err_probe(atcphy->dev, PTR_ERR(addr),
+					     "Unable to map fabric regs");
+		atcphy->regs.fabric = addr;
+		atcphy->res.fabric = res;
+	}
+
 	return 0;
 }
 
