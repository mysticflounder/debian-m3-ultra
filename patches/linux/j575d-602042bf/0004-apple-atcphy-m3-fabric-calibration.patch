+static int atcphy_validate_fabric(struct platform_device *pdev,
+					 struct apple_atcphy *atcphy)
+{
+	const struct property *fabric_prop;
+	bool property;
+	bool resource = !!platform_get_resource_byname(pdev, IORESOURCE_MEM, "fabric");
+
+	fabric_prop = of_find_property(atcphy->np, "apple,tunable-fabric", NULL);
+	property = !!fabric_prop;
+
+	if (!property && !resource)
+		return 0;
+
+	if (!atcphy->hw->fabric_tunables) {
+		dev_err(atcphy->dev,
+			"fabric resource/property is only supported with apple,t6031-atcphy\n");
+		return -EINVAL;
+	}
+
+	if (property != resource) {
+		dev_err(atcphy->dev,
+			"apple,tunable-fabric and fabric resource must be provided together\n");
+		return -EINVAL;
+	}
+
+	if (fabric_prop->length < 3 * sizeof(u32)) {
+		dev_err(atcphy->dev,
+			"apple,tunable-fabric must contain at least one tuple\n");
+		return -EINVAL;
+	}
+
+	atcphy->fabric_enabled = true;
+	return 0;
+}
