Local review patch: select T6032 secondary CPU masks from validated metadata
Base: m1n1 4184923ffb2dff079b384d6a32cc02142aa14572, after 0001..0004
Provenance: AI-assisted Debian project work; not submitted upstream.

Accept only the captured mode-1, two-die, 4/6/6-core topology. Decode
unaligned little-endian ADT bytes explicitly. Validate the complete cluster
table before producing either mask; do not guess unobserved layouts or
zero-shift fallback semantics. Other SoCs keep their original expressions
and do not depend on these ADT properties.

The preflight runs before RVBAR access, allocation or reset publication.
This is NOT native enablement: the T6032 dispatch case remains absent.
Entry state, reset ordering, register side effects and recovery still gate
any native experiment. No macOS boot-argument override is interpreted here.

--- a/src/smp.c
+++ b/src/smp.c
@@ -112,6 +112,55 @@
     return;
 }
 
+static bool smp_cpu_start_masks(int die, int cluster, int core, u32 *system_mask,
+                                u32 *cluster_mask)
+{
+    if (chip_id != T6032) {
+        *system_mask = 1 << (4 * cluster + core);
+        *cluster_mask = 1 << core;
+        return true;
+    }
+
+    if (die < 0 || die >= 2 || cluster < 0 || cluster >= 3 || core < 0)
+        return false;
+
+    int node = adt_path_offset(adt, "/arm-io/pmgr");
+    if (node < 0)
+        return false;
+
+    u32 length = 0;
+    const u8 *mode = adt_getprop(adt, node, "acc-harvesting", &length);
+    if (!mode || length != 4 || mode[0] != 1 || mode[1] || mode[2] || mode[3])
+        return false;
+
+    const u8 *clusters = adt_getprop(adt, node, "clusters", &length);
+    if (!clusters || length != 12)
+        return false;
+
+    static const u32 widths[3] = {4, 6, 6};
+    static const u32 shifts[3] = {0, 4, 10};
+    u32 selected_width = 0, selected_shift = 0;
+    for (int i = 0; i < 3; i++) {
+        const u8 *record = clusters + 4 * i;
+        u32 width = (u32)record[0] | ((u32)record[1] << 8);
+        u32 shift = (u32)record[2] | ((u32)record[3] << 8);
+        /* Only this observed layout is qualified; reject every other one. */
+        if (width != widths[i] || shift != shifts[i])
+            return false;
+        if (i == cluster) {
+            selected_width = width;
+            selected_shift = shift;
+        }
+    }
+
+    if ((u32)core >= selected_width)
+        return false;
+
+    *system_mask = 1U << (selected_shift + (u32)core);
+    *cluster_mask = 1U << (u32)core;
+    return true;
+}
+
 static void smp_start_cpu(int index, int die, int cluster, int core, u64 impl, u64 cpu_start_base)
 {
     int i;
