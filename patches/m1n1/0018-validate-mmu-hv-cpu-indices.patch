Validate MMU and hypervisor CPU indices before side effects.

Reject invalid signed indices at direct entry points, and validate raw proxy
arguments before narrowing. Only pin/unpin and exit/current-CPU accept the
all-ones u64 sentinel; translate it explicitly rather than relying on a cast.
Invalid proxy requests remain no-ops with the initialized zero return value.

--- a/src/memory.c
+++ b/src/memory.c
@@ -802,6 +802,9 @@
 
 void mmu_init_secondary(int cpu)
 {
+    if (cpu < 0 || cpu >= MAX_CPUS)
+        return;
+
     smp_call4(cpu, mmu_secondary_setup, 0, 0, 0, 0);
     smp_wait(cpu);
 }
--- a/src/hv.c
+++ b/src/hv.c
@@ -258,6 +258,9 @@
 
 void hv_start_secondary(int cpu, void *entry, u64 regs[4])
 {
+    if (cpu < 0 || cpu >= MAX_CPUS)
+        return;
+
     printf("HV: Initializing secondary %d\n", cpu);
     iodev_console_flush();
 
@@ -280,6 +283,9 @@
     if (cpu == -1)
         cpu = smp_id();
 
+    if (cpu < 0 || cpu >= MAX_CPUS)
+        return;
+
     printf("HV: Requesting exit of CPU#%d from the guest\n", cpu);
     hv_should_exit[cpu] = true;
 }
@@ -321,6 +327,9 @@
 
 void hv_pin_cpu(int cpu)
 {
+    if (cpu < -1 || cpu >= MAX_CPUS)
+        return;
+
     hv_pinned_cpu = cpu;
 }
 
