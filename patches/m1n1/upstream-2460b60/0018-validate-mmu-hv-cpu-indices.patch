Validate MMU and hypervisor CPU indices on upstream m1n1
2460b604c6f016956ead711823605eea840c602e.

Reject invalid signed indices before side effects. Proxy request arguments
remain unsigned until they pass the CPU bound. Only pin/exit preserve the
intentional all-ones u64 sentinel, translated explicitly to signed -1.
Invalid proxy requests remain no-ops with the initialized zero return.
The HV sources are now under src/hv/.

diff --git a/src/memory.c b/src/memory.c
--- a/src/memory.c
+++ b/src/memory.c
@@ -646,6 +646,9 @@
 
 void mmu_init_secondary(int cpu)
 {
+    if (cpu < 0 || cpu >= MAX_CPUS)
+        return;
+
     smp_call4(cpu, mmu_secondary_setup, 0, 0, 0, 0);
     smp_wait(cpu);
 }
diff --git a/src/hv/hv.c b/src/hv/hv.c
--- a/src/hv/hv.c
+++ b/src/hv/hv.c
@@ -336,5 +336,8 @@
 
 void hv_start_secondary(int cpu, void *entry, u64 regs[4])
 {
+    if (cpu < 0 || cpu >= MAX_CPUS)
+        return;
+
     printf("HV: Initializing secondary %d\n", cpu);
     iodev_console_flush();
@@ -357,7 +360,10 @@
 void hv_exit_cpu(int cpu)
 {
     if (cpu == -1)
         cpu = smp_id();
 
+    if (cpu < 0 || cpu >= MAX_CPUS)
+        return;
+
     printf("HV: Requesting exit of CPU#%d from the guest\n", cpu);
     hv_should_exit[cpu] = true;
@@ -401,5 +407,8 @@
 
 void hv_pin_cpu(int cpu)
 {
+    if (cpu < -1 || cpu >= MAX_CPUS)
+        return;
+
     hv_pinned_cpu = cpu;
 }
diff --git a/src/hv/hv_wdt.c b/src/hv/hv_wdt.c
--- a/src/hv/hv_wdt.c
+++ b/src/hv/hv_wdt.c
@@ -148,5 +148,8 @@
 
 void hv_wdt_start(int cpu)
 {
+    if (cpu < 0 || cpu >= MAX_CPUS)
+        return;
+
     if (hv_wdt_active)
         return;
