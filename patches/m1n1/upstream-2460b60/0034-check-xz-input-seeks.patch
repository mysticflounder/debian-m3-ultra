From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Wed, 7 Oct 2026 13:14:00 +0000
Subject: [PATCH] minilzlib: check input seeks and make rewinds explicit

Reject forward lengths against a checked remaining bound instead of adding
32-bit offsets, and represent the two intentional backwards movements with
a separately checked BfRewind operation. Reject inconsistent input state
without changing the offset or limit; propagate failed XZ position queries
and size-only skips before committing output counts.

A failed range-decoder refill must not silently inject a zero byte. Retain a
sticky failure which gates progress and completion while preserving buffered
final-symbol decoding at the input endpoint. Compute the range limit after
consuming the five initialization bytes.

Widen the encoded compressed-chunk count so the legal 0xffff + 1 length
remains 65,536 rather than wrapping to zero. This does not change raw chunk
sizes, which were already wide enough.

Host regressions exercise the actual decoder and state helpers with bounded
negative controls. Declared backing, full payload parsing, other decoder
operations, initrd placement, and physical/native-entry safety remain
separate gates. No claim of a universal codec safety proof.

AI assistance: OpenAI Codex; local Debian/project-fork work only. No Asahi
submission, hardware access, firmware, disk or VM operation.

--- a/src/minilzlib/inputbuf.c
+++ b/src/minilzlib/inputbuf.c
@@ -66,7 +66,9 @@
     uint32_t Remaining
     )
 {
-    if ((In.Size - In.Offset) < Remaining)
+    if ((In.Offset > In.SoftLimit) ||
+        (In.SoftLimit > In.Size) ||
+        (Remaining > (In.Size - In.Offset)))
     {
         return false;
     }
@@ -92,9 +94,16 @@
     // Make sure the input buffer has enough space to seek the desired size, if
     // it does, return the current position and then seek past the desired size
     //
-    if ((In.Offset + Length) > In.SoftLimit)
+    if (Bytes != NULL)
     {
-        *Bytes = 0;
+        *Bytes = NULL;
+    }
+    if ((Bytes == NULL) ||
+        (In.Buffer == NULL) ||
+        (In.Offset > In.SoftLimit) ||
+        (In.SoftLimit > In.Size) ||
+        (Length > (In.SoftLimit - In.Offset)))
+    {
         return false;
     }
     *Bytes = &In.Buffer[In.Offset];
@@ -102,6 +111,21 @@
     return true;
 }
 
+bool
+BfRewind (
+    uint32_t Length
+    )
+{
+    if ((In.Offset > In.SoftLimit) ||
+        (In.SoftLimit > In.Size) ||
+        (Length > In.Offset))
+    {
+        return false;
+    }
+    In.Offset -= Length;
+    return true;
+}
+
 uint32_t
 BfTell (
     void
@@ -116,6 +140,10 @@
     )
 {
     uint8_t* pByte;
+    if (Byte == NULL)
+    {
+        return false;
+    }
     //
     // Seek past the byte and read it
     //
--- a/src/minilzlib/lzma2dec.c
+++ b/src/minilzlib/lzma2dec.c
@@ -31,7 +31,7 @@
 Lz2DecodeChunk (
     uint32_t* BytesProcessed,
     uint32_t RawSize,
-    uint16_t CompressedSize
+    uint32_t CompressedSize
     )
 {
     uint32_t bytesProcessed;
@@ -76,7 +76,7 @@
     LZMA2_CONTROL_BYTE controlByte;
     uint8_t propertyByte;
     uint32_t rawSize;
-    uint16_t compressedSize;
+    uint32_t compressedSize;
 
     //
     // Read the first control byte
@@ -108,7 +108,7 @@
         if (controlByte.u.Common.IsLzma == 1)
         {
             rawSize = controlByte.u.Lzma.RawSize << 16;
-            compressedSize = inBytes[2] << 8;
+            compressedSize = (uint32_t)inBytes[2] << 8;
             compressedSize += inBytes[3] + 1;
         }
         else
@@ -160,9 +160,12 @@
         //
         if (GetSizeOnly)
         {
+            if (!BfSeek((controlByte.u.Common.IsLzma == 1) ? compressedSize : rawSize,
+                        &inBytes))
+            {
+                return false;
+            }
             *BytesProcessed += rawSize;
-            BfSeek((controlByte.u.Common.IsLzma == 1) ? compressedSize : rawSize,
-                   &inBytes);
             continue;
         }
         else if (controlByte.u.Common.IsLzma == 0)
--- a/src/minilzlib/minlzlib.h
+++ b/src/minilzlib/minlzlib.h
@@ -37,6 +37,7 @@
 //
 bool BfRead(uint8_t* Byte);
 bool BfSeek(uint32_t Length, uint8_t** Bytes);
+bool BfRewind(uint32_t Length);
 uint32_t BfTell(void);
 bool BfAlign(void);
 void BfInitialize(uint8_t* InputBuffer, uint32_t InputSize);
@@ -61,7 +62,7 @@
 uint8_t RcGetReverseBitTree(uint16_t* BitModel, uint8_t HighestBit);
 uint8_t RcDecodeMatchedBitTree(uint16_t* BitModel, uint8_t MatchByte);
 uint32_t RcGetFixed(uint8_t HighestBit);
-bool RcInitialize(uint16_t* ChunkSize);
+bool RcInitialize(uint32_t* ChunkSize);
 uint8_t RcIsBitSet(uint16_t* Probability);
 void RcNormalize(void);
 bool RcCanRead(void);
--- a/src/minilzlib/rangedec.c
+++ b/src/minilzlib/rangedec.c
@@ -74,26 +74,34 @@
     //
     uint32_t Range;
     uint32_t Code;
+    bool Failed;
 } RANGE_DECODER_STATE, *PRANGE_DECODER_STATE;
 RANGE_DECODER_STATE RcState;
 
 bool
 RcInitialize (
-    uint16_t* ChunkSize
+    uint32_t* ChunkSize
     )
 {
     uint8_t i, rcByte;
     uint8_t* chunkEnd;
 
+    RcState.Failed = false;
+
     //
     // Make sure that the input buffer has enough space for the requirements of
     // the range encoder. We (temporarily) seek forward to validate this.
     //
-    if (!BfSeek(*ChunkSize, &chunkEnd))
+    if ((ChunkSize == NULL) || (*ChunkSize < LZMA_RC_INIT_BYTES))
     {
+        RcState.Failed = true;
         return false;
     }
-    BfSeek(-*ChunkSize, &chunkEnd);
+    if (!BfSeek(*ChunkSize, &chunkEnd) || !BfRewind(*ChunkSize))
+    {
+        RcState.Failed = true;
+        return false;
+    }
 
     //
     // The initial probability range is set to its highest value, after which
@@ -105,7 +113,11 @@
     RcState.Code = 0;
     for (i = 0; i < LZMA_RC_INIT_BYTES; i++)
     {
-        BfRead(&rcByte);
+        if (!BfRead(&rcByte))
+        {
+            RcState.Failed = true;
+            return false;
+        }
         RcState.Code = (RcState.Code << 8) | rcByte;
     }
 
@@ -116,9 +128,13 @@
     // become 0 exactly when the compressed chunk size has been fully consumed
     // by the decoder.
     //
-    BfSeek(0, &RcState.Start);
-    RcState.Limit = RcState.Start + *ChunkSize;
+    if (!BfSeek(0, &RcState.Start))
+    {
+        RcState.Failed = true;
+        return false;
+    }
     *ChunkSize -= LZMA_RC_INIT_BYTES;
+    RcState.Limit = RcState.Start + *ChunkSize;
     return true;
 }
 
@@ -132,8 +148,7 @@
     // We can keep reading symbols as long as we haven't reached the end of the
     // input buffer yet.
     //
-    BfSeek(0, &pos);
-    return pos <= RcState.Limit;
+    return !RcState.Failed && BfSeek(0, &pos) && (pos <= RcState.Limit);
 }
 
 bool
@@ -147,7 +162,10 @@
     // there is nothing left to describe. Return the offset in the buffer where
     // this occurred (which should be equal to the compressed size).
     //
-    BfSeek(0, &pos);
+    if (RcState.Failed || (BytesProcessed == NULL) || !BfSeek(0, &pos))
+    {
+        return false;
+    }
     *BytesProcessed = (uint32_t)(pos - RcState.Start);
     return (RcState.Code == 0);
 }
@@ -165,11 +183,15 @@
     // two options appear identical with the number of precision bits that we
     // have. In this case, shift the state by a byte (8 bits) and read another.
     //
-    if (RcState.Range < LZMA_RC_MIN_RANGE)
+    if (!RcState.Failed && (RcState.Range < LZMA_RC_MIN_RANGE))
     {
         RcState.Range <<= 8;
         RcState.Code <<= 8;
-        BfRead(&rcByte);
+        if (!BfRead(&rcByte))
+        {
+            RcState.Failed = true;
+            return;
+        }
         RcState.Code |= rcByte;
     }
 }
--- a/src/minilzlib/xzstream.c
+++ b/src/minilzlib/xzstream.c
@@ -137,7 +137,10 @@
     //
     // Remember where the index started so we can compute its size
     //
-    BfSeek(0, &indexStart);
+    if (!BfSeek(0, &indexStart))
+    {
+        return false;
+    }
 
     //
     // The index always starts out with an empty byte
@@ -182,7 +185,10 @@
