From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Wed, 7 Oct 2026 11:45:00 +0000
Subject: [PATCH] heapblock: retain a ceiling for top-down reservations

Coordinate the upward heap with top_of_memory_alloc without changing its
first/later allocation placement or single movable 16-KiB guard page.
Keep a separate non-increasing reservation ceiling so clearing or widening
a requested heap limit cannot reopen live top-down allocations. Permit
reservations before heap initialization; the initial alignment must then
fit below that ceiling. Reject arithmetic overflow and heap collisions
before publishing a top-down reservation or changing boot RAM metadata.
Avoid undefined pointer subtraction when logging a cleared, pre-init, or
below-cursor requested limit; retain the normal remaining-space diagnostic.

This does not establish physical backing, carveout eligibility, mapping,
DMA coherence, or native T6032 boot safety. Requested MCC/proxy limits
remain independently mutable. Source/build/host-test qualification only.

AI assistance: OpenAI Codex; local Debian/project-fork work, not an Asahi
submission. No hardware was accessed to implement or test this change.

--- a/src/heapblock.c
+++ b/src/heapblock.c
@@ -17,6 +17,7 @@
 
 static void *heap_base;
 static void *heap_limit;
+static void *heap_top;
 
 void heapblock_init(void)
 {
@@ -31,7 +32,11 @@
 void heapblock_set_limit(void *limit)
 {
     heap_limit = limit;
-    printf("Heap limit: %p (%ld MiB)\n", limit, ((u8 *)limit - (u8 *)heap_base) >> 20);
+    if (heap_base && limit && (uintptr_t)limit >= (uintptr_t)heap_base)
+        printf("Heap limit: %p (%lu MiB)\n", limit,
+               ((uintptr_t)limit - (uintptr_t)heap_base) >> 20);
+    else
+        printf("Heap limit: %p\n", limit);
 }
 
 void *heapblock_get_cursor(void)
@@ -41,9 +46,22 @@
 
 void *heapblock_get_limit(void)
 {
+    if (heap_top && (!heap_limit || (uintptr_t)heap_top < (uintptr_t)heap_limit))
+        return heap_top;
     return heap_limit;
 }
 
+void heapblock_reserve_top(void *limit)
+{
+    if (!limit || (heap_base && (uintptr_t)limit < (uintptr_t)heap_base) ||
+        (heap_top && (uintptr_t)limit > (uintptr_t)heap_top))
+        panic("heapblock: invalid top reservation (cursor %p, top %p, new top %p)\n",
+              heap_base, heap_top, limit);
+
+    /* A requested/proxy heap limit cannot release live top reservations. */
+    heap_top = limit;
+}
+
 void *heapblock_alloc(size_t size)
 {
     return heapblock_alloc_aligned(size, 64);
@@ -51,15 +69,21 @@
 
 void *heapblock_alloc_aligned(size_t size, size_t align)
 {
-    assert((align & (align - 1)) == 0);
+    assert(align && (align & (align - 1)) == 0);
     assert(heap_base);
 
-    uintptr_t block = (((uintptr_t)heap_base) + align - 1) & ~(align - 1);
+    uintptr_t aligned, end;
+    if (__builtin_add_overflow((uintptr_t)heap_base, align - 1, &aligned))
+        panic("heapblock: alignment overflow (%zu at %p)\n", align, heap_base);
+    uintptr_t block = aligned & ~(align - 1);
+    if (__builtin_add_overflow(block, size, &end))
+        panic("heapblock: allocation overflow (%zu bytes at 0x%lx)\n", size, block);
 
-    if (heap_limit && block + size > (uintptr_t)heap_limit)
-        panic("heapblock: out of memory (%zu bytes at 0x%lx, limit %p)\n", size, block, heap_limit);
+    void *limit = heapblock_get_limit();
+    if (limit && end > (uintptr_t)limit)
+        panic("heapblock: out of memory (%zu bytes at 0x%lx, limit %p)\n", size, block, limit);
 
-    heap_base = (void *)(block + size);
+    heap_base = (void *)end;
 
     return (void *)block;
 }
--- a/src/heapblock.h
+++ b/src/heapblock.h
@@ -12,5 +12,7 @@
 void heapblock_set_limit(void *limit);
 void *heapblock_get_cursor(void);
 void *heapblock_get_limit(void);
+/* Publish a non-increasing ceiling for live top-down reservations. */
+void heapblock_reserve_top(void *limit);
 
 #endif
--- a/src/utils.c
+++ b/src/utils.c
@@ -5,6 +5,7 @@
 
 #include "utils.h"
 #include "cpu_regs.h"
+#include "heapblock.h"
 #include "iodev.h"
 #include "smp.h"
 #include "types.h"
@@ -206,19 +207,28 @@
 u64 top_of_memory_alloc(size_t size)
 {
     static bool guard_page_inserted = false;
-    cur_boot_args.mem_size -= ALIGN_UP(size, SZ_16K);
-    u64 ret = cur_boot_args.phys_base + cur_boot_args.mem_size;
+    u64 old_end, rounded, consumed, new_end, ret, allocation_end;
+    if (__builtin_add_overflow(cur_boot_args.phys_base, cur_boot_args.mem_size, &old_end) ||
+        __builtin_add_overflow((u64)size, (u64)SZ_16K - 1, &rounded))
+        panic("top_of_memory_alloc: address or size overflow\n");
 
-    if (!guard_page_inserted) {
-        cur_boot_args.mem_size -= SZ_16K;
-        guard_page_inserted = true;
-    } else {
-        // If the guard page was already there, move it down and allocate
-        // above it -- this is accomplished by simply shifting the allocated
-        // region by one page up.
-        ret += SZ_16K;
-    }
+    rounded &= ~((u64)SZ_16K - 1);
+    u64 guard_bytes = guard_page_inserted ? 0 : SZ_16K;
+    if (__builtin_add_overflow(rounded, guard_bytes, &consumed) ||
+        consumed > cur_boot_args.mem_size)
+        panic("top_of_memory_alloc: out of memory (%zu bytes)\n", size);
 
+    u64 new_size = cur_boot_args.mem_size - consumed;
+    if (__builtin_add_overflow(cur_boot_args.phys_base, new_size, &new_end) || !new_end ||
+        __builtin_add_overflow(new_end, (u64)SZ_16K, &ret) ||
+        __builtin_add_overflow(ret, rounded, &allocation_end))
+        panic("top_of_memory_alloc: reservation overflow\n");
+
+    /* Preserve the first/later placement and one movable 16-KiB guard page. */
+    heapblock_reserve_top((void *)(uintptr_t)new_end);
+    cur_boot_args.mem_size = new_size;
+    guard_page_inserted = true;
+
     return ret;
 }
 
