Validate CPU indices before indexed SMP state access on upstream m1n1
2460b604c6f016956ead711823605eea840c602e.

Reject negative signed indices before pointer formation. Proxy request fields
are u64, so validate the raw value before narrowing to int. Invalid proxy
operations retain the existing no-op/zero-return behavior.

--- a/src/smp.c
+++ b/src/smp.c
@@ -152,8 +152,8 @@
 static bool smp_start_cpu(int index, const struct cpu_info *cpu)
 {
     int i;
 
-    if (index >= MAX_CPUS)
+    if (index < 0 || index >= MAX_CPUS)
         return false;
 
     if (has_el3() && index >= MAX_EL3_CPUS)
@@ -214,8 +214,8 @@
 static void smp_stop_cpu(int index, const struct cpu_info *cpu, bool deep_sleep)
 {
     int i;
 
-    if (index >= MAX_CPUS)
+    if (index < 0 || index >= MAX_CPUS)
         return;
 
     if (!spin_table[index].flag)
@@ -478,6 +478,6 @@
 void smp_send_ipi(int cpu)
 {
-    if (cpu >= MAX_CPUS)
+    if (cpu < 0 || cpu >= MAX_CPUS)
         return;
 
     u64 mpidr = spin_table[cpu].mpidr;
@@ -491,6 +491,6 @@
 void smp_call4(int cpu, void *func, u64 arg0, u64 arg1, u64 arg2, u64 arg3)
 {
-    if (cpu >= MAX_CPUS)
+    if (cpu < 0 || cpu >= MAX_CPUS)
         return;
 
     struct spin_table *target = &spin_table[cpu];
@@ -519,6 +519,6 @@
 u64 smp_wait(int cpu)
 {
-    if (cpu >= MAX_CPUS)
+    if (cpu < 0 || cpu >= MAX_CPUS)
         return 0;
 
     struct spin_table *target = &spin_table[cpu];
@@ -544,6 +544,6 @@
 bool smp_is_alive(int cpu)
 {
-    if (cpu >= MAX_CPUS)
+    if (cpu < 0 || cpu >= MAX_CPUS)
         return false;
 
     return spin_table[cpu].flag;
@@ -552,6 +552,6 @@
 uint64_t smp_get_mpidr(int cpu)
 {
-    if (cpu >= MAX_CPUS)
+    if (cpu < 0 || cpu >= MAX_CPUS)
         return 0;
 
     return spin_table[cpu].mpidr;
@@ -560,10 +560,10 @@
 u64 smp_get_release_addr(int cpu)
 {
-    struct spin_table *target = &spin_table[cpu];
-
-    if (cpu >= MAX_CPUS)
+    if (cpu < 0 || cpu >= MAX_CPUS)
         return 0;
 
+    struct spin_table *target = &spin_table[cpu];
+
     target->args[0] = 0;
     target->args[1] = 0;
     target->args[2] = 0;
